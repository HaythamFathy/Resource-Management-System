@model List<Resource_Management_System.Models.UserListItemViewModel>
@{
    Layout = null;
}
<!DOCTYPE html>
<html dir="rtl" lang="ar">

<head>
    <meta charset="utf-8" />
    <title>إدارة المستخدمين</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="~/lib/material-symbols/material-symbols-outlined.css" rel="stylesheet" asp-append-version="true" />
    <style>
            body {
                font-family: Cairo, sans-serif;
                background: #f9f9ff
            }
    </style>
</head>

<body class="p-8">
    <main class="max-w-5xl mx-auto space-y-6">
        <header class="flex justify-between items-center">
            <div>
                <h1 class="text-2xl font-bold">إدارة المستخدمين</h1>
                <p class="text-sm text-gray-500">كل حسابات النظام، القسم المرتبط بها، وتحديث/حذف الحساب.</p>
            </div>
            <div class="flex gap-3">
                <a href="/UserManagement/Create"
                   class="bg-teal-700 text-white px-4 py-2 rounded-lg">+ إضافة مستخدم</a><a href="/Home/Index"
                                                                                         class="text-teal-700 py-2">الرئيسية</a>
            </div>
        </header>
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="p-3 bg-green-50 border border-green-200 text-green-800 rounded-lg">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="p-3 bg-red-50 border border-red-200 text-red-800 rounded-lg">@TempData["ErrorMessage"]</div>
        }

        <div class="relative">
            <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-gray-400">search</span>
            <input id="userSearch" type="text" placeholder="ابحث بالاسم أو الصلاحية أو القسم..."
                   autocomplete="off"
                   class="w-full border border-gray-300 rounded-lg py-2.5 pr-10 pl-4 text-sm focus:outline-none focus:ring-2 focus:ring-[#34435E]/30" />
        </div>

        <section class="bg-white rounded-xl shadow overflow-hidden">
            <div class="p-4" style="background-color:#34435E;">
                <h2 class="font-bold text-white">كل المستخدمين</h2>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-right">
                    <thead class="bg-gray-50 text-gray-600 text-sm">
                        <tr>
                            <th class="p-4">اسم المستخدم</th>
                            <th class="p-4">الصلاحية</th>
                            <th class="p-4">القسم</th>
                            <th class="p-4">كلمة مرور جديدة</th>
                            <th class="p-4">إدارة الحساب</th>
                        </tr>
                    </thead>
                    <tbody id="userTableBody">
                        @foreach (var user in Model)
                        {
                            <tr class="border-t user-row"
                                data-search="@($"{user.UserName} {user.RoleName} {user.DepartmentName}".ToLower())">
                                <td class="p-4 font-semibold">@user.UserName</td>
                                <td class="p-4">@user.RoleName</td>
                                <td class="p-4">@(user.DepartmentName ?? "-")</td>
                                <td class="p-4">
                                    <form asp-action="ResetPassword" method="post" class="flex gap-2">
                                        @Html.AntiForgeryToken()<input type="hidden" name="UserID" value="@user.UserID" />
                                        <input type="password" name="NewPassword" placeholder="كلمة مرور جديدة"
                                               minlength="6" required class="border rounded px-2 py-1 text-sm w-40" />
                                        <button class="bg-gray-100 text-sm px-3 py-1 rounded">تحديث</button>
                                    </form>
                                </td>
                                <td class="p-4">
                                    <div class="flex gap-2">

                                        @if (user.IsActive)
                                        {
                                            <form asp-action="DisableUser" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@user.UserID" />

                                                <button type="submit" onclick="return confirm('هل تريد تعطيل هذا الحساب؟');"
                                                        class="bg-yellow-500 text-white px-3 py-1 rounded text-sm">
                                                    تعطيل
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="ReactivateUser" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="userId" value="@user.UserID" />

                                                <button type="submit"
                                                        onclick="return confirm('هل تريد إعادة تفعيل هذا الحساب؟');"
                                                        class="bg-green-600 text-white px-3 py-1 rounded text-sm">
                                                    تفعيل
                                                </button>
                                            </form>
                                        }

                                        <form asp-action="DeleteUser" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@user.UserID" />

                                            <button type="submit" onclick="return confirm('حذف الحساب؟');"
                                                    class="bg-red-600 text-white px-3 py-1 rounded text-sm">
                                                حذف
                                            </button>
                                        </form>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p id="userNoResults" class="hidden text-center text-gray-500 py-8">لا يوجد مستخدمين مطابقين للبحث.</p>
            </div>
        </section>
    </main>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
            document.getElementById('userSearch')?.addEventListener('input', function(e) {
                var term = normalizeArabicSearch(e.target.value);
                var rows = document.querySelectorAll('.user-row');
                var visibleCount = 0;
                rows.forEach(function(row) {
                    var match = normalizeArabicSearch(row.dataset.search).includes(term);
                    row.style.display = match ? '' : 'none';
                    if (match) visibleCount++;
                });
                var noResults = document.getElementById('userNoResults');
                if (noResults) noResults.classList.toggle('hidden', visibleCount !== 0);
            });
    </script>
</body>

</html>
