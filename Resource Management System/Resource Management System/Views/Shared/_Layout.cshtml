<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Resource_Management_System</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Resource_Management_System.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentUserRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? string.Empty;
    }
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Resource_Management_System</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Resource_Management_System - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    @if (currentUserRole == "Approver")
    {
        <div id="requestNotification" style="display:none; position:fixed; top:20px; left:20px; z-index:1050; max-width:320px; background:#fff; padding:14px 16px; border-radius:12px; box-shadow:0 10px 30px rgba(0,0,0,0.15); border:1px solid #34435E33;"></div>
    }
    @if (currentUserRole == "IT" || currentUserRole == "Admin")
    {
        <div id="lowStockNotification" style="display:none; position:fixed; top:20px; right:20px; z-index:1050; max-width:320px; background:#fff; padding:14px 16px; border-radius:12px; box-shadow:0 10px 30px rgba(0,0,0,0.15); border:1px solid #f9414433;"></div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    @if (currentUserRole == "Approver")
    {
        <script>
                fetch('/PaperManagement/Request/NotificationFeed').then(function(r) { return r.json(); }).then(function(items) {
                    if (!items || !items.length) return;
                    var popup = document.getElementById('requestNotification');
                    popup.innerHTML = '<strong style="display:block;color:#34435E;margin-bottom:6px;">طلبات تحتاج إجراء</strong>' +
                        items.map(function(x) { return '<div style="font-size:13px;padding:2px 0;">' + x.message + '</div>'; }).join('');
                    popup.style.display = 'block';
                    setTimeout(function() { popup.style.display = 'none'; }, 9000);
                }).catch(function() { });
        </script>
    }
    @if (currentUserRole == "IT" || currentUserRole == "Admin")
    {
        <script>
                fetch('/PaperManagement/Request/LowStockFeed').then(function(r) { return r.json(); }).then(function(items) {
                    if (!items || !items.length) return;
                    var popup = document.getElementById('lowStockNotification');
                    popup.innerHTML = '<strong style="display:block;color:#f94144;margin-bottom:6px;">تنبيه: مخزون منخفض</strong>' +
                        items.map(function(x) { return '<div style="font-size:13px;padding:2px 0;">' + x.name + ' (' + x.stock + ')</div>'; }).join('');
                    popup.style.display = 'block';
                    setTimeout(function() { popup.style.display = 'none'; }, 9000);
                }).catch(function() { });
        </script>
    }
</body>
</html>
