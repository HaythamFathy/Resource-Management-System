@model Resource_Management_System.Models.ChangeInitialPasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>تغيير كلمة المرور</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link href="~/lib/material-symbols/material-symbols-outlined.css" rel="stylesheet" asp-append-version="true" />
    <style>        body {
                font-family: Cairo, sans-serif;
            }

            .input-validation-error {
                border-color: #b91c1c !important;
                background: #fff7f7;
        }</style>
    </head>
    <body class="min-h-screen bg-slate-50 flex items-center justify-center p-4">
        <main class="w-full max-w-md bg-white border border-slate-200 shadow-sm rounded-2xl p-8">
            <div class="w-12 h-12 bg-teal-100 text-teal-800 rounded-xl flex items-center justify-center text-xl mb-5"><span class="material-symbols-outlined">lock</span></div>
            <h1 class="text-2xl font-extrabold text-slate-900">غيّر كلمة المرور</h1>
            <p class="mt-2 text-sm text-slate-600">هذه أول مرة تدخل فيها إلى الحساب. اختر كلمة مرور خاصة بك قبل متابعة استخدام النظام.</p>

            <form asp-action="ChangePassword" method="post" class="mt-7 space-y-5">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-sm text-red-700"></div>
                <div>
                    <label asp-for="NewPassword" class="block mb-1 font-bold text-sm"></label>
                    <input asp-for="NewPassword" class="w-full rounded-lg border-slate-300 focus:border-teal-700 focus:ring-teal-700" autocomplete="new-password" />
                </div>
                <div>
                    <label asp-for="ConfirmPassword" class="block mb-1 font-bold text-sm"></label>
                    <input asp-for="ConfirmPassword" class="w-full rounded-lg border-slate-300 focus:border-teal-700 focus:ring-teal-700" autocomplete="new-password" />
                </div>
                <button type="submit" class="w-full rounded-lg bg-teal-700 hover:bg-teal-800 text-white py-3 font-bold">حفظ كلمة المرور والمتابعة</button>
            </form>
        </main>
    </body>
</html>
