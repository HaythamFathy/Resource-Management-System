<script>
    var fpFrom, fpTo;

    function initReportFilters() {
        var fpConfig = {
            locale: "ar",
            dateFormat: "Y-m-d",
            allowInput: true,
            disableMobile: true,
            onClose: function(selectedDates) {
                if (selectedDates && selectedDates.length) paperScheduleInstantFilter(document.getElementById('periodForm'), 140);
            }
        };

        fpFrom = flatpickr("#fromDateInput", fpConfig);
        fpTo = flatpickr("#toDateInput", fpConfig);
        updateSelectedCount();
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initReportFilters, { once: true });
    else initReportFilters();

    function setPreset(type) {
        var now = new Date();
        var fromStr = "";
        var toStr = "";

        if (type === 'today') {
            fromStr = toStr = formatDate(now);
        } else if (type === 'week') {
            var daysSinceSaturday = (now.getDay() + 1) % 7;
            var weekStart = new Date(now.getFullYear(), now.getMonth(), now.getDate() - daysSinceSaturday);
            var weekEnd = new Date(weekStart.getFullYear(), weekStart.getMonth(), weekStart.getDate() + 6);
            fromStr = formatDate(weekStart);
            toStr = formatDate(weekEnd);
        } else if (type === 'month') {
            var firstDay = new Date(now.getFullYear(), now.getMonth(), 1);
            var lastDay = new Date(now.getFullYear(), now.getMonth() + 1, 0);
            fromStr = formatDate(firstDay);
            toStr = formatDate(lastDay);
        } else if (type === 'year') {
            var firstYearDay = new Date(now.getFullYear(), 0, 1);
            var lastYearDay = new Date(now.getFullYear(), 11, 31);
            fromStr = formatDate(firstYearDay);
            toStr = formatDate(lastYearDay);
        } else if (type === 'all') {
            fromStr = "";
            toStr = "";
        }

        if (fpFrom) fpFrom.setDate(fromStr, true);
        if (fpTo) fpTo.setDate(toStr, true);
        paperScheduleInstantFilter(document.getElementById('periodForm'), 100);
    }

    function formatDate(d) {
        var month = '' + (d.getMonth() + 1);
        var day = '' + d.getDate();
        var year = d.getFullYear();
        if (month.length < 2) month = '0' + month;
        if (day.length < 2) day = '0' + day;
        return [year, month, day].join('-');
    }

    function toggleChecklistPanel() {
        var panel = document.getElementById('checklistPanel');
        var chevron = document.getElementById('checklistChevron');
        var isHidden = panel.classList.contains('hidden');

        if (isHidden) {
            panel.classList.remove('hidden');
            chevron.style.transform = 'rotate(180deg)';
        } else {
            panel.classList.add('hidden');
            chevron.style.transform = 'rotate(0deg)';
        }
    }

    function selectAllDepts(checked) {
        document.querySelectorAll('.dept-checkbox').forEach(function (cb) {
            cb.checked = checked;
        });
        updateSelectedCount();
        paperScheduleInstantFilter(document.getElementById('periodForm'), 650);
    }

    function selectGroupDepts(group, checked) {
        document.querySelectorAll('.checklist-item[data-group="' + group + '"] .dept-checkbox').forEach(function (cb) {
            cb.checked = checked;
        });
        updateSelectedCount();
        paperScheduleInstantFilter(document.getElementById('periodForm'), 650);
    }

    function updateSelectedCount() {
        var checkboxes = document.querySelectorAll('.dept-checkbox');
        var total = checkboxes.length;
        var checkedCount = document.querySelectorAll('.dept-checkbox:checked').length;

        var countBadge = document.getElementById('selectedCountBadge');
        var triggerLabel = document.getElementById('triggerBtnLabel');

        if (checkedCount === 0 || checkedCount === total) {
            if (countBadge) countBadge.innerText = 'الكل (' + total + ')';
            if (triggerLabel) triggerLabel.innerText = 'جميع الجهات والأقسام مشمولة';
        } else {
            if (countBadge) countBadge.innerText = checkedCount + ' من ' + total;
            if (triggerLabel) triggerLabel.innerText = 'تم تحديد (' + checkedCount + ') جهة';
        }
    }

    function filterChecklistItems(query) {
        var q = normalizeArabicSearch(query);
        document.querySelectorAll('.checklist-item').forEach(function (item) {
            var name = normalizeArabicSearch(item.getAttribute('data-name') || '');
            if (!q || name.indexOf(q) !== -1) {
                item.style.display = 'flex';
            } else {
                item.style.display = 'none';
            }
        });
    }

    function exportToExcel() {
        var fromVal = (document.getElementById('fromDateInput')?.value || '').trim();
        var toVal = (document.getElementById('toDateInput')?.value || '').trim();

        var params = new URLSearchParams();
        if (fromVal) params.append('FromDate', fromVal);
        if (toVal) params.append('ToDate', toVal);

        var checkboxes = document.querySelectorAll('.dept-checkbox');
        var total = checkboxes.length;
        var checkedBoxes = document.querySelectorAll('.dept-checkbox:checked');

        if (checkedBoxes.length > 0 && checkedBoxes.length < total) {
            checkedBoxes.forEach(function (cb) {
                params.append('SelectedDepartmentIDs', cb.value);
            });
        }

        window.location.href = '/PaperManagement/Request/ExportReportToExcel?' + params.toString();
    }
</script>
