@model Resource_Management_System.Models.NewRequestViewModel
@{
    ViewData["Title"] = "تقديم طلب صرف ورق جديد";
    var userRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
}

<div class="max-w-2xl mx-auto">
    @{
        var departmentNotices = ViewBag.DepartmentNotifications as IEnumerable<Resource_Management_System.Models.DepartmentNotificationViewModel>
            ?? Enumerable.Empty<Resource_Management_System.Models.DepartmentNotificationViewModel>();
    }
    @if (departmentNotices.Any())
    {
        <div class="mb-4 p-3.5 rounded-lg bg-amber-50 border border-amber-300 text-amber-950 text-sm">
            <p class="font-bold mb-2">تنبيه بشأن طلب الورق</p>
            @foreach (var notice in departmentNotices)
            {
                <p>@notice.Message</p>
            }
        </div>
    }
    <!-- Header -->
    <div class="mb-3">
        <h2 class="text-xl font-extrabold text-on-surface leading-tight">تقديم طلب صرف ورق جديد</h2>
    </div>

    <!-- Main Request Form Card -->
    <div class="bg-surface-white rounded-xl p-6 shadow-sm border border-border-light">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-4 p-3.5 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-semibold flex items-center gap-2">
                <i class="bi bi-check-circle-fill text-lg"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>
        }

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="mb-4 p-3.5 rounded-lg bg-red-50 border border-red-200 text-red-800 text-sm font-semibold">
                <div asp-validation-summary="All" class="space-y-1"></div>
            </div>
        }

        <form asp-area="PaperManagement" asp-controller="Request" asp-action="Create" method="post" class="space-y-5" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="SubmissionKey" />

            @if (userRole != Roles.Department)
            {
                <!-- Department Selection for Admin/IT -->
                <div class="space-y-2">
                    <label asp-for="DepartmentID" class="block font-bold text-sm text-on-surface">القسم المستفيد <span class="text-red-600" aria-hidden="true">*</span></label>
                    <div class="relative">
                        <select asp-for="DepartmentID" asp-items="@Model.Departments" required class="block w-full pr-10 pl-4 py-3 bg-white border border-border-light rounded-lg text-on-surface font-semibold focus:ring-2 focus:ring-primary-container focus:border-primary outline-none transition-all">
                            <option value="">-- اختر القسم --</option>
                        </select>
                    </div>
                    <span asp-validation-for="DepartmentID" class="text-xs text-red-600 font-semibold"></span>
                </div>
            }

            <!-- Paper Type (Fixed to A4 for Normal Requests) -->
            <input type="hidden" asp-for="PaperTypeID" id="@Html.IdFor(m => m.PaperTypeID)" value="@Model.PaperTypeID" />
            <span asp-validation-for="PaperTypeID" class="text-xs text-red-600 font-semibold"></span>

            <!-- Quota Information -->
            <div id="quotaCard"
                 class="hidden mt-4 rounded-2xl border border-amber-200 bg-gradient-to-br from-amber-50 to-white p-5 shadow-sm transition-all duration-300">

                <div class="flex items-start justify-between gap-4">

                    <div class="flex items-center gap-3">

                        <div class="w-11 h-11 rounded-xl bg-amber-100 flex items-center justify-center">
                            <i class="bi bi-pie-chart-fill text-amber-700 text-lg"></i>
                        </div>

                        <div>
                            <p class="font-extrabold text-gray-900">
                                حصة القسم
                            </p>

                            <p id="quotaPaperName"
                               class="text-xs text-gray-500 mt-0.5">
                                حصة هذا النوع من الورق
                            </p>
                        </div>

                    </div>

                    <span id="quotaStatusBadge"
                          class="px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-700">
                        متاح
                    </span>

                </div>


                <!-- Numbers -->

                <div class="grid grid-cols-3 gap-3 mt-5">

                    <div class="rounded-xl bg-white border border-gray-100 p-3 text-center">

                        <p class="text-[11px] text-gray-500 font-semibold">
                            الحصة الشهرية
                        </p>

                        <p id="quotaLimit"
                           class="text-xl font-extrabold text-gray-900 mt-1">
                            -
                        </p>

                        <p id="quotaLimitUnit" class="text-[10px] text-gray-400">
                            رزمة
                        </p>

                    </div>


                    <div class="rounded-xl bg-white border border-gray-100 p-3 text-center">

                        <p class="text-[11px] text-gray-500 font-semibold">
                            المستخدم
                        </p>

                        <p id="quotaUsed"
                           class="text-xl font-extrabold text-gray-900 mt-1">
                            -
                        </p>

                        <p id="quotaUsedUnit" class="text-[10px] text-gray-400">
                            رزمة
                        </p>

                    </div>


                    <div class="rounded-xl bg-emerald-50 border border-emerald-100 p-3 text-center">

                        <p class="text-[11px] text-emerald-700 font-semibold">
                            المتبقي
                        </p>

                        <p id="quotaRemaining"
                           class="text-xl font-extrabold text-emerald-700 mt-1">
                            -
                        </p>

                        <p id="quotaRemainingUnit" class="text-[10px] text-emerald-600">
                            رزمة
                        </p>

                    </div>

                </div>


                <!-- Progress -->

                <div class="mt-5">

                    <div class="flex justify-between text-[11px] mb-1.5">

                        <span class="font-semibold text-gray-500">
                            استهلاك الحصة
                        </span>

                        <span id="quotaPercentage"
                              class="font-bold text-gray-700">
                            0%
                        </span>

                    </div>

                    <div class="h-2.5 bg-gray-100 rounded-full overflow-hidden">

                        <div id="quotaProgress"
                             class="h-full bg-emerald-500 rounded-full transition-all duration-500"
                             style="width:0%">
                        </div>

                    </div>

                </div>


                <!-- After request -->

                <div id="quotaAfterRequest"
                     class="hidden mt-4 p-3 rounded-xl bg-blue-50 border border-blue-100">

                    <div class="flex items-center gap-2">

                        <i class="bi bi-info-circle-fill text-blue-600"></i>

                        <p class="text-sm text-blue-900">

                            بعد تقديم هذا الطلب سيبقى لديك

                            <strong id="quotaAfterValue">
                                0
                            </strong>

                            <span id="quotaAfterUnit">رزمة</span>.

                        </p>

                    </div>

                </div>


                <!-- Exceeded -->

                <div id="quotaExceeded"
                     class="hidden mt-4 p-3 rounded-xl bg-red-50 border border-red-200">

                    <div class="flex items-start gap-2">

                        <i class="bi bi-exclamation-triangle-fill text-red-600 mt-0.5"></i>

                        <div>

                            <p class="text-sm font-bold text-red-800">
                                الكمية المطلوبة تتجاوز الحصة المتبقية
                            </p>

                            <p class="text-xs text-red-700 mt-1">
                                يمكنك تقديم طلب استثناء للحصول على كمية إضافية.
                            </p>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Quantity Requested -->
            <div class="space-y-2">
                <label asp-for="RequestedQuantity" class="block font-bold text-sm text-on-surface">الكمية المطلوبة (بالرزمة) <span class="text-red-600">*</span></label>
                <div class="relative">
                    <input asp-for="RequestedQuantity"
                           id="requestedQuantity"
                           type="number"
                           min="1"
                           max="100000" class="block w-full pr-10 pl-4 py-3 bg-white border border-border-light rounded-lg text-on-surface font-semibold focus:ring-2 focus:ring-primary-container focus:border-primary outline-none transition-all" placeholder="أدخل الكمية المطلوبة" />
                </div>
                <span asp-validation-for="RequestedQuantity" class="text-xs text-red-600 font-semibold"></span>
            </div>

            <!-- Notes -->
            <div class="space-y-2">
                <label asp-for="Notes" class="block font-bold text-sm text-on-surface">ملاحظات (اختياري)</label>
                <textarea asp-for="Notes" rows="3" class="block w-full p-4 bg-white border border-border-light rounded-lg text-on-surface font-semibold focus:ring-2 focus:ring-primary-container focus:border-primary outline-none transition-all placeholder:text-gray-400" placeholder="اكتب أي ملاحظات إضافية بخصوص هذا الطلب..."></textarea>
            </div>

            <!-- Submit Button -->
            <button id="submitRequestButton"
                    type="submit" class="w-full py-3.5 px-6 bg-primary text-white font-bold text-base rounded-lg shadow-sm hover:bg-primary/90 active:scale-[0.99] transition-all flex items-center justify-center gap-2">
                <span>إرسال الطلب للاعتماد</span>
                <i class="bi bi-send-fill text-lg"></i>
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function() {

            const paperTypeSelect =
                document.getElementById('@Html.IdFor(m => m.PaperTypeID)');

            const departmentSelect =
                document.getElementById('@Html.IdFor(m => m.DepartmentID)');

            const quantityInput =
                document.getElementById('requestedQuantity');

            // The int view-model renders as 0 on a fresh form.
            // Clear only that default value so the user can type immediately.
            if (quantityInput && quantityInput.value === '0') {
                quantityInput.value = '';
            }

            const quotaCard =
                document.getElementById('quotaCard');

            const quotaLimit =
                document.getElementById('quotaLimit');

            const quotaUsed =
                document.getElementById('quotaUsed');

            const quotaRemaining =
                document.getElementById('quotaRemaining');

            const quotaLimitUnit =
                document.getElementById('quotaLimitUnit');

            const quotaUsedUnit =
                document.getElementById('quotaUsedUnit');

            const quotaRemainingUnit =
                document.getElementById('quotaRemainingUnit');

            const quotaAfterUnit =
                document.getElementById('quotaAfterUnit');

            const quotaPercentage =
                document.getElementById('quotaPercentage');

            const quotaProgress =
                document.getElementById('quotaProgress');

            const quotaAfterRequest =
                document.getElementById('quotaAfterRequest');

            const quotaAfterValue =
                document.getElementById('quotaAfterValue');

            const quotaExceeded =
                document.getElementById('quotaExceeded');

            const quotaStatusBadge =
                document.getElementById('quotaStatusBadge');

            const submitButton =
                document.getElementById('submitRequestButton');

            let currentRemainingQuota = null;

            let quotaRequestVersion = 0;


            function setSubmitDisabled(disabled) {

                submitButton.disabled = disabled;

                submitButton.classList.toggle(
                    'opacity-50',
                    disabled
                );

                submitButton.classList.toggle(
                    'cursor-not-allowed',
                    disabled
                );
            }


            function resetQuotaDisplay() {

                quotaRequestVersion++;

                currentRemainingQuota = null;

                quotaCard.classList.add('hidden');

                quotaAfterRequest.classList.add('hidden');

                quotaExceeded.classList.add('hidden');

                setSubmitDisabled(false);
            }


            async function loadQuota() {

                const paperTypeId =
                    paperTypeSelect.value;

                const departmentId =
                    departmentSelect
                        ? departmentSelect.value
                        : null;

                if (
                    !paperTypeId ||
                    (departmentSelect && !departmentId)
                ) {

                    resetQuotaDisplay();

                    return;
                }


                const requestVersion =
                    ++quotaRequestVersion;


                currentRemainingQuota = null;


                quotaCard.classList.remove('hidden');


                quotaLimit.textContent = '...';
                quotaUsed.textContent = '...';
                quotaRemaining.textContent = '...';

                setSubmitDisabled(true);


                try {

                    const query =
                        new URLSearchParams({
                            paperTypeId: paperTypeId
                        });

                    if (departmentId) {
                        query.set(
                            'departmentId',
                            departmentId
                        );
                    }

                    const url =
                        '@Url.Action("GetPaperQuotaStatus", "Request", new { area = "PaperManagement" })'
                        + '?'
                        + query.toString();


                    const response =
                        await fetch(url, {
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            },
                            cache: 'no-store'
                        });


                    if (!response.ok) {
                        throw new Error(
                            'Failed to load quota'
                        );
                    }


                    const data =
                        await response.json();


                    if (requestVersion !== quotaRequestVersion) {
                        return;
                    }


                    currentRemainingQuota =
                        Number(data.remainingQuota) || 0;


                    quotaLimit.textContent =
                        Number(data.quotaLimit).toLocaleString('en-US');
                    if (quotaLimitUnit) quotaLimitUnit.textContent = rezmaUnit(data.quotaLimit);

                    quotaUsed.textContent =
                        Number(data.usedQuota).toLocaleString('en-US');
                    if (quotaUsedUnit) quotaUsedUnit.textContent = rezmaUnit(data.usedQuota);

                    quotaRemaining.textContent =
                        currentRemainingQuota.toLocaleString('en-US');
                    if (quotaRemainingUnit) quotaRemainingUnit.textContent = rezmaUnit(currentRemainingQuota);


                    /*
                     * Progress percentage
                     */

                    let percentage = 0;

                    if (data.quotaLimit > 0) {

                        percentage =
                            Math.round(
                                (data.usedQuota /
                                    data.quotaLimit) * 100
                            );

                    }

                    percentage =
                        Math.min(100, Math.max(0, percentage));


                    quotaPercentage.textContent =
                        percentage + '%';

                    quotaProgress.style.width =
                        percentage + '%';


                    /*
                     * Update status
                     */

                    if (currentRemainingQuota <= 0) {

                        quotaStatusBadge.textContent =
                            'لا يوجد رصيد';

                        quotaStatusBadge.className =
                            'px-3 py-1 rounded-full text-xs font-bold bg-red-100 text-red-700';

                        quotaRemaining.className =
                            'text-xl font-extrabold text-red-700 mt-1';

                        quotaProgress.className =
                            'h-full bg-red-500 rounded-full transition-all duration-500';

                    }
                    else if (
                        currentRemainingQuota <=
                        data.quotaLimit * 0.2
                    ) {

                        quotaStatusBadge.textContent =
                            'الرصيد منخفض';

                        quotaStatusBadge.className =
                            'px-3 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-700';

                        quotaRemaining.className =
                            'text-xl font-extrabold text-amber-700 mt-1';

                        quotaProgress.className =
                            'h-full bg-amber-500 rounded-full transition-all duration-500';

                    }
                    else {

                        quotaStatusBadge.textContent =
                            'متاح';

                        quotaStatusBadge.className =
                            'px-3 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-700';

                        quotaRemaining.className =
                            'text-xl font-extrabold text-emerald-700 mt-1';

                        quotaProgress.className =
                            'h-full bg-emerald-500 rounded-full transition-all duration-500';

                    }


                    updateRequestedQuantity();

                }
                catch (error) {

                    console.error(
                        'Quota loading error:',
                        error
                    );

                    if (requestVersion !== quotaRequestVersion) {
                        return;
                    }

                    currentRemainingQuota = null;

                    quotaCard.classList.add('hidden');

                    setSubmitDisabled(false);
                }
            }


            function updateRequestedQuantity() {

                const requested =
                    Number(quantityInput.value) || 0;


                quotaAfterRequest.classList.add('hidden');

                quotaExceeded.classList.add('hidden');


                if (requested <= 0) {

                    setSubmitDisabled(false);

                    return;
                }


                if (currentRemainingQuota === null) {

                    setSubmitDisabled(false);

                    return;
                }


                const remainingAfter =
                    currentRemainingQuota - requested;


                if (requested > currentRemainingQuota) {

                    quotaExceeded.classList.remove('hidden');

                    setSubmitDisabled(true);

                    return;
                }

                setSubmitDisabled(false);


                quotaAfterValue.textContent =
                    remainingAfter.toLocaleString('en-US');
                if (quotaAfterUnit) quotaAfterUnit.textContent = rezmaUnit(remainingAfter);

                quotaAfterRequest.classList.remove(
                    'hidden'
                );
            }


            if (paperTypeSelect && paperTypeSelect.tagName === 'SELECT') {
                paperTypeSelect.addEventListener(
                    'change',
                    loadQuota
                );
            }


            if (departmentSelect) {

                departmentSelect.addEventListener(
                    'change',
                    loadQuota
                );
            }


            quantityInput.addEventListener(
                'input',
                updateRequestedQuantity
            );


            /*
             * Load quota automatically if
             * a paper type is already selected.
             */

            if (
                paperTypeSelect.value &&
                (!departmentSelect || departmentSelect.value)
            ) {
                loadQuota();
            }

        });
    </script>
}
