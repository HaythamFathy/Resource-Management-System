    </section>
</div>

<script>
    (function() {
        if (typeof flatpickr === 'undefined') return;

        var start = document.getElementById('contractStartDate');
        var newEnd = document.getElementById('newContractEndDate');
        var newEndPicker = null;

        if (newEnd) {
            newEndPicker = flatpickr(newEnd, {
                locale: 'ar',
                dateFormat: 'Y-m-d',
                disableMobile: true,
                allowInput: true,
                minDate: start && start.value ? start.value : 'today'
            });

            var clearBtn = document.getElementById('clearNewContractEndDate');
            if (clearBtn) {
                clearBtn.addEventListener('click', function() {
                    if (newEndPicker) {
                        newEndPicker.clear();
                    } else {
                        newEnd.value = '';
                    }
                });
            }
        }

        if (start) {
            flatpickr(start, {
                locale: 'ar',
                dateFormat: 'Y-m-d',
                disableMobile: true,
                allowInput: true,
                onChange: function(selectedDates, dateStr) {
                    if (newEndPicker && dateStr) {
                        newEndPicker.set('minDate', dateStr);
                        if (newEnd.value && newEnd.value < dateStr) {
                            newEndPicker.clear();
                        }
                    }
                }
            });
        }

        // Also synchronize the optional end date when StartDate is edited by typing.
        if (start) {
            start.addEventListener('change', function() {
                if (!newEndPicker) return;
                var typedStart = start.value;
                if (!/^\d{4}-\d{2}-\d{2}$/.test(typedStart)) return;
                newEndPicker.set('minDate', typedStart);
                if (newEnd && newEnd.value && newEnd.value < typedStart) {
                    newEndPicker.clear();
                }
            });
        }

        var end = document.getElementById('contractEndDate');
        if (end) {
            flatpickr(end, {
                locale: 'ar',
                dateFormat: 'Y-m-d',
                disableMobile: true,
                allowInput: false,
                minDate: '@(Model.ActiveContract?.StartDate.ToString("yyyy-MM-dd") ?? "")',
                maxDate: 'today'
            });
        }
    })();
</script>
