@model Resource_Management_System.Models.DepartmentHomeViewModel
@{
    ViewData["Title"] = "نظام إدارة الورق";

    string Num(int value) => value.ToString("N0", System.Globalization.CultureInfo.InvariantCulture);
    string DepartmentStatusHelp(string status) => status switch
    {
        RequestStatus.Approved => "تم اعتماد الطلب بالكامل وهو جاهز للصرف.",
        RequestStatus.Issued => "تم صرف الورق لهذا الطلب.",
        RequestStatus.Rejected or "RejectedByIT" => "لم تتم الموافقة على الطلب.",
        _ => "الطلب قيد المراجعة. سيظهر التحديث هنا عند اكتماله."
    };
}

<div class="space-y-6">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-emerald-900 flex items-center gap-3" role="status">
            <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center shrink-0">
                <span class="material-symbols-outlined">check_circle</span>
            </div>
            <div>
                <p class="font-black">تم بنجاح</p>
                <p class="text-sm mt-0.5">@TempData["SuccessMessage"]</p>
            </div>
        </div>
    }

    <!-- First-time-user header -->
    <section class="overflow-hidden rounded-2xl border border-[#34435E]/20 bg-white shadow-sm">
        <div class="bg-[#34435E] text-white px-5 py-6 lg:px-7">
            <p class="text-sm font-bold text-white/75 mb-1">مرحباً بك في</p>
            <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4">
                <div>
                    <h1 class="text-2xl lg:text-3xl font-black">نظام إدارة الورق</h1>
                    <p class="text-sm text-white/80 mt-2">@Model.DepartmentName</p>
                </div>
                <div class="rounded-xl bg-white/10 border border-white/15 px-4 py-3 text-sm">
                    <span class="font-black">ابدأ من هنا:</span>
                    اختر ما تريد عمله من البطاقات الثلاث التالية.
                </div>
            </div>
        </div>
    </section>

    <!-- Three obvious jobs -->
    <section aria-labelledby="department-actions-title">
        <div class="flex items-center justify-between gap-3 mb-3">
            <h2 id="department-actions-title" class="text-lg font-black text-on-surface">ماذا تريد أن تفعل؟</h2>
            <span class="text-xs font-bold text-neutral-500">اختر بطاقة واحدة</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <a href="/PaperManagement/Request/Create"
               class="group rounded-2xl border-2 border-[#34435E] bg-white p-5 hover:bg-[#34435E]/[0.03] transition-all shadow-sm focus:outline-none focus:ring-4 focus:ring-[#58a4b0]/25">
                <div class="flex items-start gap-4">
                    <div class="w-12 h-12 rounded-xl bg-[#34435E] text-white flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-2xl">add_circle</span>
                    </div>
                    <div class="min-w-0">
                        <h3 class="text-lg font-black text-[#34435E]">طلب صرف جديد</h3>
                        <p class="text-sm text-neutral-600 mt-1 leading-6">اطلب ورقاً من الحصة الشهرية للجهة.</p>
                        <span class="inline-flex items-center gap-1 text-sm font-black text-[#34435E] mt-4">
                            ابدأ الطلب
                            <span class="material-symbols-outlined text-lg">arrow_back</span>
                        </span>
                    </div>
                </div>
            </a>

            <a href="/PaperManagement/Request/MyRequests"
               class="group rounded-2xl border border-neutral-300 bg-white p-5 hover:border-[#58a4b0] transition-all shadow-sm focus:outline-none focus:ring-4 focus:ring-[#58a4b0]/20">
                <div class="flex items-start gap-4">
                    <div class="w-12 h-12 rounded-xl bg-sky-100 text-sky-700 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-2xl">fact_check</span>
                    </div>
                    <div class="min-w-0">
                        <h3 class="text-lg font-black text-on-surface">متابعة طلباتي</h3>
                        <p class="text-sm text-neutral-600 mt-1 leading-6">شاهد حالة الطلبات السابقة.</p>
                        <span class="inline-flex items-center gap-1 text-sm font-black text-primary mt-4">
                            عرض الطلبات
                            <span class="material-symbols-outlined text-lg">arrow_back</span>
                        </span>
                    </div>
                </div>
            </a>

            <a href="/PaperManagement/Request/ExceptionRequest"
               class="group rounded-2xl border border-amber-300 bg-amber-50/60 p-5 hover:bg-amber-50 transition-all shadow-sm focus:outline-none focus:ring-4 focus:ring-amber-200/60">
                <div class="flex items-start gap-4">
                    <div class="w-12 h-12 rounded-xl bg-amber-100 text-amber-800 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined text-2xl">warning</span>
                    </div>
                    <div class="min-w-0">
                        <h3 class="text-lg font-black text-amber-900">طلب استثناء</h3>
                        <p class="text-sm text-amber-900/75 mt-1 leading-6">استخدمه عند نفاد الحصة الشهرية والحاجة إلى كمية إضافية، أو لطلب ورق A3.</p>
                        <span class="inline-flex items-center gap-1 text-sm font-black text-amber-900 mt-4">
                            تقديم استثناء
                            <span class="material-symbols-outlined text-lg">arrow_back</span>
                        </span>
                    </div>
                </div>
            </a>
        </div>
    </section>

    @if (Model.RejectedRequestCount > 0)
    {
        <div class="rounded-xl border border-red-200 bg-red-50 p-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-red-100 text-red-700 flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined">error</span>
                </div>
                <div>
                    <p class="font-black text-red-900">لديك @Num(Model.RejectedRequestCount) طلب مرفوض</p>
                    <p class="text-sm text-red-800 mt-0.5">افتح «طلباتي» لمعرفة الملاحظة قبل تقديم طلب جديد.</p>
                </div>
            </div>
            <a href="/PaperManagement/Request/MyRequests" class="rounded-xl bg-red-700 hover:bg-red-800 text-white px-4 py-2.5 text-sm font-black text-center">فتح طلباتي</a>
        </div>
    }

    <!-- Answer-first summary -->
    <section class="rounded-2xl border border-border-light bg-white p-5 shadow-sm">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2 mb-4">
            <div>
                <h2 class="text-lg font-black text-on-surface">ملخص الجهة الآن</h2>
            </div>
            <a href="/PaperManagement/Request/MyRequests" class="text-sm font-black text-primary hover:underline">عرض كل طلباتي</a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-5 gap-3">
            <div class="rounded-xl border border-amber-200 bg-amber-50/50 p-4">
                <p class="text-sm font-bold text-amber-900">طلبات قيد الانتظار</p>
                <p class="text-3xl font-black text-amber-800 mt-1">@Num(Model.PendingRequestCount)</p>
                <p class="text-xs text-amber-800/75 mt-1">ما زالت تحت المراجعة ولم يكتمل اعتمادها بعد.</p>
            </div>

            <div class="rounded-xl border border-cyan-200 bg-cyan-50/50 p-4">
                <p class="text-sm font-bold text-cyan-900">جاهز للصرف</p>
                <p class="text-3xl font-black text-cyan-800 mt-1">@Num(Model.ReadyToIssueRequestCount)</p>
                <p class="text-xs text-cyan-800/75 mt-1">تم اعتماده بالكامل وينتظر الصرف.</p>
            </div>

            <div class="rounded-xl border border-emerald-200 bg-emerald-50/50 p-4">
                <p class="text-sm font-bold text-emerald-900">تم صرفه هذا الشهر</p>
                <p class="text-3xl font-black text-emerald-800 mt-1">@Num(Model.IssuedThisMonthQuantity)</p>
                <p class="text-xs text-emerald-800/75 mt-1">@QuantityHelper.RezmaUnit(Model.IssuedThisMonthQuantity) · @Num(Model.IssuedThisMonthCount) طلب</p>
            </div>

            <div class="rounded-xl border border-sky-200 bg-sky-50/50 p-4">
                <p class="text-sm font-bold text-sky-900">إجمالي طلباتي</p>
                <p class="text-3xl font-black text-sky-800 mt-1">@Num(Model.TotalRequestCount)</p>
                <p class="text-xs text-sky-800/75 mt-1">كل طلبات الجهة المسجلة في النظام.</p>
            </div>

            <div class="rounded-xl border border-neutral-200 bg-neutral-50 p-4">
                <p class="text-sm font-bold text-neutral-700">تم صرفها</p>
                <p class="text-3xl font-black text-neutral-800 mt-1">@Num(Model.IssuedRequestCount)</p>
                <p class="text-xs text-neutral-500 mt-1">طلب مكتمل منذ بداية استخدام النظام.</p>
            </div>
        </div>
    </section>

    <!-- Quota shown without requiring the user to select a paper type -->
    <section class="rounded-2xl border border-border-light bg-white p-5 shadow-sm">
        <div class="mb-4">
            <h2 class="text-lg font-black text-on-surface">الحصة الشهرية</h2>
        </div>

        @if (Model.Quotas.Any())
        {
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                @foreach (var quota in Model.Quotas)
                {
                    var isExhausted = quota.IsExhausted;
                    var remainingClass = isExhausted ? "text-red-700" : "text-emerald-700";
                    var badgeClass = isExhausted
                        ? "bg-red-100 text-red-800 border-red-200"
                        : "bg-emerald-100 text-emerald-800 border-emerald-200";
                    var progressClass = isExhausted ? "bg-red-500" : (quota.UsagePercent >= 80 ? "bg-amber-500" : "bg-emerald-500");

                    <article class="rounded-xl border border-neutral-200 p-4 bg-neutral-50/50">
                        <div class="flex items-start justify-between gap-3">
                            <div>
                                <p class="text-lg font-black text-on-surface">ورق @quota.PaperTypeName</p>
                            </div>
                            <span class="rounded-full border px-2.5 py-1 text-xs font-black @badgeClass">
                                @(isExhausted ? "الحصة نفدت" : "متاح للطلب")
                            </span>
                        </div>

                        <div class="grid grid-cols-3 gap-2 mt-4 text-center">
                            <div class="rounded-lg bg-white border border-neutral-200 p-3">
                                <p class="text-xs font-bold text-neutral-500">الحصة</p>
                                <p class="text-xl font-black text-on-surface mt-1">@Num(quota.QuotaLimit)</p>
                            </div>
                            <div class="rounded-lg bg-white border border-neutral-200 p-3">
                                <p class="text-xs font-bold text-neutral-500">المستخدم</p>
                                <p class="text-xl font-black text-on-surface mt-1">@Num(quota.UsedQuota)</p>
                            </div>
                            <div class="rounded-lg bg-white border border-neutral-200 p-3">
                                <p class="text-xs font-bold text-neutral-500">المتبقي</p>
                                <p class="text-xl font-black @remainingClass mt-1">@Num(quota.RemainingQuota)</p>
                            </div>
                        </div>

                        <div class="mt-4">
                            <div class="flex items-center justify-between text-xs font-bold text-neutral-600 mb-1.5">
                                <span>استهلاك الحصة</span>
                                <span>@Num(quota.UsagePercent)%</span>
                            </div>
                            <div class="h-2.5 rounded-full bg-neutral-200 overflow-hidden">
                                <div class="h-full rounded-full @progressClass" style="width:@quota.UsagePercent%"></div>
                            </div>
                        </div>

                        <p class="text-sm font-bold mt-4 @(isExhausted ? "text-amber-900" : "text-emerald-800")">
                            @(isExhausted
                                ? "إذا كنت تحتاج كمية إضافية الآن، استخدم «طلب استثناء»."
                                : $"يمكنك طلب حتى {Num(quota.RemainingQuota)} {QuantityHelper.RezmaUnit(quota.RemainingQuota)} من هذا النوع ضمن الحصة.")
                        </p>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="rounded-xl bg-neutral-50 border border-neutral-200 p-5 text-sm text-neutral-600 text-center">
                لا توجد بيانات حصة متاحة حالياً.
            </div>
        }
    </section>

    <!-- Recent requests with privacy-safe statuses -->
    <section class="rounded-2xl border border-border-light bg-white p-5 shadow-sm">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-4">
            <div>
                <h2 class="text-lg font-black text-on-surface">آخر الطلبات</h2>
            </div>
            <a href="/PaperManagement/Request/MyRequests" class="text-sm font-black text-primary hover:underline">عرض السجل الكامل</a>
        </div>

        @if (Model.RecentRequests.Any())
        {
            <div class="space-y-3">
                @foreach (var request in Model.RecentRequests)
                {
                    var badge = StatusDisplayHelper.GetDepartmentBadgeInfo(request.Status);
                    <article class="rounded-xl border border-neutral-200 p-4 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                        <div class="flex items-start gap-3 min-w-0">
                            <div class="w-11 h-11 rounded-xl bg-primary/10 text-primary flex items-center justify-center shrink-0">
                                <span class="material-symbols-outlined">description</span>
                            </div>
                            <div class="min-w-0">
                                <div class="flex flex-wrap items-center gap-2">
                                    <h3 class="font-black text-on-surface">طلب #@Num(request.RequestID)</h3>
                                    @await Html.PartialAsync("_DepartmentStatusBadge", request.Status)
                                    @if (request.IsException)
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full border border-amber-300 bg-amber-100 text-amber-900 px-2 py-0.5 text-xs font-black">
                                            <span class="material-symbols-outlined text-sm">warning</span> استثناء
                                        </span>
                                    }
                                </div>
                                <p class="text-sm text-neutral-700 mt-1">@request.PaperTypeName · @Num(request.RequestedQuantity) @QuantityHelper.RezmaUnit(request.RequestedQuantity)</p>
                                <p class="text-xs text-neutral-500 mt-1">@DepartmentStatusHelp(request.Status)</p>
                            </div>
                        </div>
                        <div class="text-sm text-neutral-500 shrink-0">
                            @request.RequestDate.ToEgyptTime().ToString("yyyy/MM/dd HH:mm", System.Globalization.CultureInfo.InvariantCulture)
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="rounded-xl border-2 border-dashed border-neutral-200 bg-neutral-50 p-8 text-center">
                <span class="material-symbols-outlined text-4xl text-neutral-400">inbox</span>
                <p class="font-black text-on-surface mt-2">لا توجد طلبات حتى الآن</p>
                <p class="text-sm text-neutral-500 mt-1">يمكنك البدء من زر «طلب صرف جديد» أعلى الصفحة.</p>
                <a href="/PaperManagement/Request/Create" class="inline-flex items-center gap-2 rounded-xl bg-primary text-white px-4 py-2.5 text-sm font-black mt-4">
                    <span class="material-symbols-outlined">add</span>
                    طلب صرف جديد
                </a>
            </div>
        }
    </section>
</div>
