            @if (visibleDepts.Count == 0)
            {
                <tr><td class="rc-td text-slate-500 text-center" colspan="@(visibleIssueTypes.Count + 3 + (showTotal ? 1 : 0))">لا توجد حركات صرف مطابقة.</td></tr>
            }
        </tbody>
        @if (visibleDepts.Count > 0)
        {
            <tfoot>
                <tr class="bg-slate-50 font-bold">
                    <td class="rc-td" colspan="3">إجمالي الجهات المحددة</td>@foreach (var paper in visibleIssueTypes){
                    <td class="rc-td font-bold">@(visibleDepts.Sum(d => d.Quantity(paper)).ToString("N0"))</td>
                }
                @if (showTotal)
                {
                    <td class="rc-td font-black">@(visibleDepts.Sum(d => d.Total).ToString("N0"))</td>
                }
            </tr>
        </tfoot>
    }
</table>
</div>
</div>
                    }
</section>
</div>
        }
        else if (isContractDetail && !Model.ContractId.HasValue)
{
    <div class="rc-card text-slate-500 text-sm">اختر العقد لعرض تقريره.</div>
}
</div>
    }
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/ar.js"></script>
    <script>
        function rcPeriodMode(){
            const mode=document.querySelector('input[name="period"]:checked')?.value || 'year';
            document.querySelectorAll('.rc-period-year,.rc-period-years,.rc-period-dates').forEach(field=>{
                const active=field.classList.contains('rc-period-'+mode);
                field.style.display=active?'':'none';
                field.querySelectorAll('input,select').forEach(input=>input.disabled=!active);
            });
        }
        rcPeriodMode();
        if(typeof flatpickr==='function'){
            document.querySelectorAll('.rc-date').forEach(input=>{
                flatpickr(input,{locale:'ar',dateFormat:'Y-m-d',disableMobile:true,allowInput:false});
            });
        } else {
            // Native fallback if the date-picker CDN is unavailable.
            document.querySelectorAll('.rc-date').forEach(input=>input.type='date');
        }
        function rcEmbedOfficial(frame){
            // Embed the ORIGINAL company report without changing Reports.cshtml,
            // its filters, its signature block or its print/Excel functions.
            try {
                const doc=frame.contentDocument;
                if(!doc) return;
                const css=doc.createElement('style');
                css.textContent='@@media screen {html,body{height:auto!important;min-height:0!important;overflow:visible!important;background:#fff!important}body{display:block!important;margin:0!important}body>header,body>footer{display:none!important}main#paperPageContent{height:auto!important;max-width:none!important;min-height:0!important;margin:0!important;padding:6px!important;overflow:visible!important}/* Inside Reports Center only: keep original report functions and hide redundant action/status widgets. */#periodForm>div:first-child>div:last-child>span,#periodForm>div:first-child>div:last-child>button{display:none!important}#periodForm>div:first-child>div:last-child{display:flex!important;justify-content:center;align-items:flex-end}#periodForm>div:first-child{grid-template-columns:repeat(3,minmax(0,1fr)) 54px!important}}@@media screen and (max-width:1023px){#periodForm>div:first-child{grid-template-columns:repeat(2,minmax(0,1fr))!important}}@@media screen and (max-width:640px){#periodForm>div:first-child{grid-template-columns:1fr!important}}';
                doc.head.appendChild(css);
                const measure=()=>{
                    if(!frame.isConnected) return;
                    const body=doc.body,html=doc.documentElement;
                    if(!body||!html)return;
                    const content=doc.querySelector('main#paperPageContent')||body;
                    const height=Math.max(content.scrollHeight,body.scrollHeight,html.scrollHeight,200)+8;
                    if(Math.abs(frame.offsetHeight-height)>3)frame.style.height=height+'px';
                };
                frame.style.overflow='hidden';
                // Nested scrollbars are disabled; the parent page is the sole scroll surface.
                const observer=new MutationObserver(measure);
                observer.observe(doc.body,{childList:true,subtree:true,characterData:true});
                if(typeof ResizeObserver!=='undefined')new ResizeObserver(measure).observe(doc.body);
                doc.addEventListener('change',()=>requestAnimationFrame(measure),true);
                doc.addEventListener('click',()=>requestAnimationFrame(measure),true);
                window.addEventListener('resize',measure);
                measure();
                setTimeout(measure,150);
                setTimeout(measure,500);
                setTimeout(measure,1400);
            }catch(e){console.warn('Original report could not be auto-sized.',e);}
        }
        function rcSearchDepartments(query){
            const text=(query||'').trim().toLocaleLowerCase();
            document.querySelectorAll('.rc-dept-list [data-rc-dept-name]').forEach(el=>{
                el.style.display=el.dataset.rcDeptName.toLocaleLowerCase().includes(text)?'':'none';
            });
        }
        function rcSyncDepartmentCount(){
            const form=document.getElementById('rc-dept-form');if(!form)return;
            const count=form.querySelectorAll('input[name="departmentIds"]:checked').length;
            const empty=form.querySelector('#rc-empty-selection');
            if(empty)empty.disabled=count>0;
            const badge=document.getElementById('rc-dept-count');
            if(badge)badge.textContent=count?count+' محددة':empty&&!empty.disabled?'لا توجد جهة محددة':'الكل';
        }
        let rcDepartmentTimer=null,rcFetchController=null;
        function rcDepartmentChanged(){
            rcSyncDepartmentCount();
            clearTimeout(rcDepartmentTimer);
            rcDepartmentTimer=setTimeout(()=>{
                const form=document.getElementById('rc-dept-form');if(!form)return;
                const url=new URL(form.action,window.location.origin);
                url.search=new URLSearchParams(new FormData(form)).toString();
                rcFetch(url.toString(),false);
            },180);
        }
        function rcSelectDepartments(checked){
            const form=document.getElementById('rc-dept-form');if(!form)return;
            form.querySelectorAll('input[type="checkbox"][name="departmentIds"]').forEach(el=>el.checked=checked);
            rcDepartmentChanged();
        }
        function rcSelectDepartmentGroup(group,checked){
            const form=document.getElementById('rc-dept-form');if(!form)return;
            form.querySelectorAll('input[type="checkbox"][name="departmentIds"]').forEach(el=>el.checked=false);
            form.querySelectorAll('.rc-dept-group:nth-child('+group+') input[type="checkbox"]').forEach(el=>el.checked=checked);
            rcDepartmentChanged();
        }
        async function rcFetch(url,replaceAll){
            if(rcFetchController) rcFetchController.abort();
            const controller=new AbortController();rcFetchController=controller;
            const target=document.getElementById(replaceAll?'rc-live':'reports-center-results');
            const status=document.getElementById('rc-live-status');
            if(status) status.textContent='جارِ تحديث التقرير...';
            if(target) target.classList.add('rc-live-busy');
            const savedScroll=window.scrollY;
            try{
                const response=await fetch(url,{headers:{'X-ReportsCenter-Partial':'1'},credentials:'same-origin',signal:controller.signal});
                if(!response.ok) throw new Error('HTTP '+response.status);
                const html=await response.text();
                const parsed=new DOMParser().parseFromString(html,'text/html');
                const next=parsed.getElementById(replaceAll?'rc-live':'reports-center-results');
                const liveTarget=document.getElementById(replaceAll?'rc-live':'reports-center-results');
                if(!next||!liveTarget) throw new Error('Report content missing');
                const pickerWasOpen=!!document.querySelector('#rc-dept-picker[open]');
                liveTarget.replaceWith(next);
                if(pickerWasOpen){const picker=document.getElementById('rc-dept-picker');if(picker)picker.open=true;}
                // Keep the Excel download in sync with the selected departments too.
                if(!replaceAll){
                    const nextExcel=parsed.querySelector('#rc-title a.rc-excel');
                    const currentExcel=document.querySelector('#rc-title a.rc-excel');
                    if(nextExcel&&currentExcel) currentExcel.href=nextExcel.href;
                }
                history.replaceState({},'',url);
                window.scrollTo({top:savedScroll,behavior:'auto'});
                if(replaceAll) rcSyncDepartmentCount();
            }catch(error){
                if(error.name!=='AbortError'){
                    console.error('Instant report update failed:',error);
                    const label=document.getElementById('rc-live-status');
                    if(label)label.textContent='تعذر التحديث الفوري. يرجى إعادة المحاولة.';
                }
            }finally{
                if(rcFetchController===controller){rcFetchController=null;
                    document.querySelectorAll('#rc-live.rc-live-busy,#reports-center-results.rc-live-busy').forEach(el=>el.classList.remove('rc-live-busy'));
                    const label=document.getElementById('rc-live-status');if(label && label.textContent==='جارِ تحديث التقرير...')label.textContent='';
                        }
                    }
                }
        document.addEventListener('click',e=>{
            const link=e.target.closest('a[data-rc-live-link]');if(!link)return;
            e.preventDefault();clearTimeout(rcDepartmentTimer);rcFetch(link.href,true);
                });
        document.addEventListener('submit',e=>{
            if(e.target.id!=='rc-dept-form')return;
            e.preventDefault();clearTimeout(rcDepartmentTimer);rcDepartmentChanged();
                });
    </script>
}
