    {
        <p class="text-xs text-slate-500">ملخص المجموعتين لجميع الجهات؛ تم تطبيق اختيار الجهات على جدول التفاصيل فقط.</p>
    }
</div>
@if (Model.Detail == "departments")
{
    <div class="rc-card space-y-3">
        <h3 class="font-black text-lg">تفاصيل المصروف حسب الجهة</h3>
        <div class="rc-table-wrapper overflow-x-auto">
            <table class="w-full min-w-[620px] text-right">
                <thead>
                    <tr>
                        <th class="rc-th">كود</th>
                        <th class="rc-th">الجهة</th>
                        <th class="rc-th">المجموعة</th>@foreach (var paper in visibleIssueTypes){
                        <th class="rc-th">@paper</th>
                    }
                    @if (showTotal)
                    {
                        <th class="rc-th">الإجمالي</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var d in visibleDepts)
                {
                    <tr>
                        <td class="rc-td">@d.ID</td>
                        <td class="rc-td font-bold">@d.Name</td>
                        <td class="rc-td">@d.GroupName</td>@foreach (var paper in visibleIssueTypes){
                        <td class="rc-td">@d.Quantity(paper).ToString("N0")</td>
                    }
                    @if (showTotal)
                    {
                        <td class="rc-td font-bold">@d.Total.ToString("N0")</td>
